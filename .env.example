# .env로 복사한 뒤 값을 채운다. .env는 git에 올라가지 않는다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
WHISPER_MODEL=large-v3-turbo
# auto: cuda를 시도하고 실패하면 cpu(int8)로 폴백. cuda 또는 cpu로 고정할 수도 있다.
WHISPER_DEVICE=auto
# PDF 앞에서 건너뛸 쪽 수. 올려둔 PDF는 첫 장을 이미 뺀 파일이라 0.
RECORD_SKIP_PAGES=0
# 생기부에서 지울 지원자 이름과 고등학교 이름. 비워 두면 그대로 API에 전송된다.
MASK_NAME=
MASK_SCHOOL=
